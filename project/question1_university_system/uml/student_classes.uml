@startuml
' ======================================
' Layout & style for horizontal diagram
' ======================================
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam packagePadding 25
skinparam classPadding 15
skinparam packageMargin 60
skinparam dpi 150

' ======================================
' Horizontal grouping of packages
' ======================================
together {
    ' -------------------------
    ' Managers
    ' -------------------------
    package "Managers" {
        interface IStudentManager {
            +enroll()
            +drop()
            +set_results()
            +gpa()
        }

        class StudentManagerImp {
            +enroll()
            +drop()
            +set_results()
            +gpa()
            +_get_courses()
        }

        interface ICourseManager {
            +add_student()
            +remove_student()
            +assign_faculty()
        }

        class CourseManagerImp {
            +add_student()
            +remove_student()
            +assign_faculty()
        }

        IStudentManager <|-- StudentManagerImp
        ICourseManager <|-- CourseManagerImp
    }

    ' -------------------------
    ' Core Classes
    ' -------------------------
    package "Core" {
        class AcademicStatus {
            +from_gpa()
        }
        Enum <|-- AcademicStatus

        class Grade {
        }
        Enum <|-- Grade

        class Results {
            -semester
            -course_code
            -course_grade : Grade
        }
        Results --> Grade

        class Course {
            +add_student()
            +remove_student()
            +add_faculty()
            -course_code
            -course_name
            -course_credits
            -max_students_allowd
            -reading_students : List[str]
            -should_have_completed
            -_course_manager : ICourseManager
            -assigned_faculty : List[str]
        }
        Course --> ICourseManager
    }

    ' -------------------------
    ' People & Students
    ' -------------------------
    package "People" {
        abstract class Person {
            +get_responsibilities()
            -person_id
            -name
        }

        class Faculty {
            +get_responsibilities()
            +calculate_workload()
            -department
        }

        class Professor {
            +get_responsibilities()
            +calculate_workload()
            -research_area
        }

        class Lecturer {
            +get_responsibilities()
            +calculate_workload()
            -teach_subjects
        }

        class TA {
            +get_responsibilities()
            +calculate_workload()
            -assistant_to
        }

        class Student {
            +semester_courses()
            +course_results()
            +get_academic_status()
            +enroll_course()
            +drop_course()
            +set_results()
            +calculate_gpa()
            +get_responsibilities()
            -student_id
            -_gpa
            -_academic_status : AcademicStatus
            -_student_manager : IStudentManager
            +gpa
        }

        class UndergraduateStudent {
            +get_responsibilities()
        }

        class GraduateStudent {
            +get_responsibilities()
        }

        Person <|-- Faculty
        Person <|-- Student
        Faculty <|-- Professor
        Faculty <|-- Lecturer
        Faculty <|-- TA
        Student <|-- UndergraduateStudent
        Student <|-- GraduateStudent
        Student --> IStudentManager
        Student --> AcademicStatus
    }
}

' ======================================
' ABC Relationships (outside packages)
' ======================================
ABC <|-- IStudentManager
ABC <|-- ICourseManager
ABC <|-- Person

@enduml
``
